# Replace before use; load these values into your shell environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
RESTAURANTES_URL=http://localhost:8082

# Optional first-administrator bootstrap. Disable after provisioning.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_LASTNAME=
BOOTSTRAP_ADMIN_DOCUMENT=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_BIRTHDATE=

